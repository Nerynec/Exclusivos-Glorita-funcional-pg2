# Copiá este archivo como ".env" y completá con tus datos reales.
# NUNCA subas el archivo ".env" real a GitHub (ya está en .gitignore).

# --- Conexión a Supabase (PostgreSQL) ---
# La sacás de: tu proyecto en Supabase -> Project Settings -> Database
# -> "Connection string" -> pestaña "URI". Se ve así:
# postgresql://postgres:TU_PASSWORD@db.xxxxxxxxxxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.xxxxxxxxxxxxxxxx.supabase.co:5432/postgres

# Supabase exige conexión cifrada (SSL) — dejalo en true
DB_SSL=true

# --- Seguridad ---
JWT_SECRET=cambia_este_valor_por_una_cadena_larga_y_aleatoria
JWT_EXPIRES_IN=8h

# --- Servidor ---
PORT=4000
# URL pública donde vas a publicar el frontend (Netlify/Vercel).
# Mientras desarrollás en tu compu, dejalo en http://localhost:5173
CORS_ORIGIN=http://localhost:5173
